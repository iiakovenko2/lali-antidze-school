---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
}

const { title = "ლალი ანთიძის საკვირაო სკოლა" } = Astro.props;
---

<!DOCTYPE html>
<html lang="ka">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
</head>
<body>

<div class="container"> 
    
    <!-- This pulls in everything from your Header.astro file -->
    <Header />

    <!-- Page Specific Content Injected Here -->
    <slot />

</div>

<footer>
    &copy; ლალი ანთიძის საკვირაო სკოლა 2026
</footer>

</body>
</html>